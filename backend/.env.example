# ==============================================================================
# Johnny TEC AI Reply (v2) - Backend Environment Variables
# Copy this file to .env on local machine or set in Render Environment dashboard.
# Never commit real credentials to GitHub.
# ==============================================================================

# Gemini AI API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy..."

# Gemini model identifier (e.g. gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Supabase Project URL (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase SERVICE ROLE Key (Required for backend bypass of RLS - NEVER expose to frontend!)
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Owner account email address created in Supabase Auth (Only this email can access the API)
OWNER_EMAIL="johnny@example.com"

# Meta WhatsApp Cloud API System User Access Token (from Meta Developer portal)
WA_TOKEN="EAA..."

# WhatsApp Business Phone Number ID (from WhatsApp -> API Setup in Meta portal)
WA_PHONE_NUMBER_ID="123456789012345"

# Webhook verification secret token that YOU invent and register in Meta webhook setup
WA_VERIFY_TOKEN="jt_verify_super_secret_2026"

# Meta App Secret (from App Dashboard -> App Settings -> Basic -> App Secret)
# Used to verify HMAC-SHA256 signature on incoming webhooks (X-Hub-Signature-256)
WA_APP_SECRET="0123456789abcdef0123456789abcdef"

# Graph API Version
WA_API_VERSION="v21.0"

# Allowed CORS Origin for the PWA frontend (e.g. https://your-user.github.io or * for all)
ALLOWED_ORIGIN="*"

# DRY RUN MODE:
# Set to 'true' to simulate WhatsApp sending without calling Meta's API (great for testing).
# Set to 'false' in production when ready to send live WhatsApp messages.
DRY_RUN="true"
